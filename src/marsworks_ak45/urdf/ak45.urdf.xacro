<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ak45">
  <link name="base_link"/>
  <link name="output_link"/>
  <joint name="ak45_joint" type="revolute">
    <parent link="base_link"/>
    <child link="output_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="24.0" velocity="5.44"/>
  </joint>
  <ros2_control name="ak45_system" type="system">
    <hardware>
      <plugin>cubemars_hardware/CubeMarsSystemHardware</plugin>
      <param name="can_interface">vcan0</param>
    </hardware>
    <joint name="ak45_joint">
      <param name="can_id">111</param>
      <param name="pole_pairs">14</param>
      <param name="gear_ratio">36</param>
      <param name="kt">0.11</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
    </joint>
  </ros2_control>
</robot>
